{
  "name": "claimscout",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "claimscout",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@claimscout/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@claimscout/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@claimscout/cli",
      "version": "0.1.0",
      "dependencies": {
        "@claimscout/core": "0.1.0"
      },
      "bin": {
        "claimscout": "bin/claimscout.js"
      }
    },
    "packages/core": {
      "name": "@claimscout/core",
      "version": "0.1.0"
    }
  }
}
